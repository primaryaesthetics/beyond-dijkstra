version: 0.1.0
date-released: 2026-07-21
url: "https://github.com/primaryaesthetics/beyond-dijkstra"
repository-code: "https://github.com/primaryaesthetics/beyond-dijkstra"
license: MIT
keywords:
  - shortest paths
